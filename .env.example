# Copiar a .env (no versionado) y completar. Valores por defecto: GW-C §5.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=9090
LOG_LEVEL=INFO
GATEWAY_DOWNSTREAM_TIMEOUT_MS=3000

# Destinos: obligatorio por MS activo (los perfiles local/docker traen el de MS01).
MS01_URI=http://localhost:8081
# MS08_URI=http://ms08-analytics-and-audit:8088

# Se usan a partir de RF-GW-02, RF-GW-04 y RF-GW-08 (secretos: nunca en el repositorio).
# JWT_PUBLIC_KEY=
# JWT_ISSUER=ms01-identity-and-access
# JWT_AUDIENCE=campusseguro
# JWT_CLOCK_SKEW_SECONDS=30
# JWT_MAX_LIFETIME_SECONDS=3600
# CORS_ALLOWED_ORIGINS=
# CORS_ALLOW_CREDENTIALS=false
# CORS_MAX_AGE_SECONDS=3600
# GW_SERVICE_KEY_MS01=
# GATEWAY_DOCS_ENABLED=false
