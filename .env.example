# Copiar a .env (no versionado) y completar. Valores por defecto: GW-C §5.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=9090
LOG_LEVEL=INFO
GATEWAY_DOWNSTREAM_TIMEOUT_MS=3000

# Destinos: obligatorio por MS activo (los perfiles local/docker traen el de MS01).
MS01_URI=http://localhost:8081
# MS08_URI=http://ms08-analytics-and-audit:8088

# JWT (obligatoria la llave pública RSA del mismo par que JWT_PRIVATE_KEY de MS01): PEM completo,
# con saltos de línea reales o escapados (\n), o solo el contenido Base64 entre BEGIN y END.
JWT_PUBLIC_KEY=
JWT_ISSUER=ms01-identity-and-access
JWT_AUDIENCE=campusseguro
JWT_CLOCK_SKEW_SECONDS=30
JWT_MAX_LIFETIME_SECONDS=3600

# CORS: orígenes del frontend separados por coma, sin barra final (obligatorio; los perfiles local y docker traen el de Vite).
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE_SECONDS=3600

# Claves de servicio (>= 32 caracteres, una distinta por MS; solo las de los MS que llaman a través del GW).
# Generar con: openssl rand -base64 48
GW_SERVICE_KEY_MS01=
GW_SERVICE_KEY_MS02=
GW_SERVICE_KEY_MS03=
GW_SERVICE_KEY_MS04=
GW_SERVICE_KEY_MS05=
GW_SERVICE_KEY_MS06=
GW_SERVICE_KEY_MS07=
GW_SERVICE_KEY_MS08=

# Solo para docker compose: llave privada de MS01 (PKCS#8, una línea con \n escapados), del mismo par que JWT_PUBLIC_KEY.
JWT_PRIVATE_KEY=

# Sin uso: el GW no publica un OpenAPI propio; su contrato está en documentation/api-gateway/api/swagger.yml.
# GATEWAY_DOCS_ENABLED=false
