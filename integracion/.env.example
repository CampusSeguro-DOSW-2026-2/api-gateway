# Copiar a .env (no versionado) junto al docker-compose.yml de la plantilla y completar. Guía: integracion/README.md.

# --- Lo que cambia cada squad ---
# Prefijos de su MS tal como están en su swagger.yml, separados por coma y sin espacios (todos bajo /api/v1/).
# El ejemplo es de MS04; reemplazarlo por los propios.
SQUAD_PATHS=/api/v1/evacuations,/api/v1/evacuations/**
# Clave de servicio de su MS (>= 32 caracteres). Solo si su MS llama a otro MS. Generar con: openssl rand -base64 48
SQUAD_SERVICE_KEY=

# --- Llaves JWT (par RSA de desarrollo, ver la guía). Mejor exportarlas en la terminal y dejar esto vacío;
#     si se ponen aquí, van en una sola línea con \n escapados. ---
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# --- MS01 (identidad) ---
MS01_DB_PASSWORD=cambiar-por-una-clave-local
# Primer ADMIN (opcional), para probar rutas de administración.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=

# --- Opcionales (estos son los valores por defecto) ---
# GW_TAG=integracion
# GW_PORT=8080
# MS01_REF=develop
# MS01_DB_NAME=campus_db
# MS01_DB_USERNAME=campus_user
# MS01_SERVICE_KEY=
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# LOG_LEVEL=INFO
